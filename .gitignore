# ignorar auth do whatsapp (credenciais Baileys multi-tenant)
lib/whatsapp/auth_info/*
lib/whatsapp/sessions/*
!lib/whatsapp/sessions/.gitkeep
lib/whatsapp/media_cache/*
# PII: mapeamento LID -> telefone real de pacientes (LGPD)
lib/whatsapp/lid_map.json
# Buffers temporários do bridge (áudios/imagens em trânsito)
lib/whatsapp/in_*.tmp
lib/whatsapp/out_*.tmp
lib/whatsapp/*.tmp
node_modules
/log/*
/tmp/*
/storage/*
/public/assets
/public/packs
/public/vite
/public/vite-dev
/public/vite-test
.bundle
.DS_Store
.env*
!.env.example
log/*.log

# ----------------- ARQUIVOS TEMPORÁRIOS & LOGS NA RAIZ ----------------- #
# Logs na raiz do projeto (ex: rails.log, foreman.log, vite.log, etc)
/*.log

# Textos e logs temporários soltos
/temp*.txt
/win_temp.txt
/chatwoot_msgs*.txt
/*.patch

# Node / PNPM Debug Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

