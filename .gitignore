# Node/PNPM stores e caches
.pnpm-store/

# Ignorar o Alternate Data Streams do Windows (Mark of the Web) no WSL
# U+F03A é o caractere que o WSL usa para representar ':' de ADS do NTFS
*:Zone.Identifier
*Zone.Identifier
*Zone.Identifier

