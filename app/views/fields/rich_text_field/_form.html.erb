<%# Quill rich text editor — bootstrap em app/javascript/superadmin_pages/quill_editor.js %>
<div class="field-unit__label">
  <%= f.label field.attribute %>
</div>
<div class="field-unit__field">
  <div class="ha-quill-wrap" data-quill-field>
    <div class="ha-quill-editor"></div>
    <textarea
      class="ha-quill-html"
      style="display:none; width:100%; min-height:300px; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 13px;"
    ><%= field.data %></textarea>
    <%= f.hidden_field field.attribute, value: field.data, class: 'ha-quill-input' %>
  </div>
</div>

<style>
  .ha-quill-wrap { border: 1px solid #d1d5db; border-radius: 6px; background: #fff; }
  .ha-quill-wrap .ql-toolbar { border: 0; border-bottom: 1px solid #e5e7eb; border-top-left-radius: 6px; border-top-right-radius: 6px; }
  .ha-quill-wrap .ql-container { border: 0; min-height: 360px; font-size: 14px; }
  .ha-quill-wrap .ql-toolbar { padding: 6px 8px; }
  .ha-quill-wrap .ql-toolbar .ql-formats { margin-right: 8px; }
  .ha-quill-wrap.ha-quill--html .ha-quill-editor,
  .ha-quill-wrap.ha-quill--html .ql-toolbar > .ql-formats:not(.ha-quill-html-toggle-wrap) { display: none; }
  .ha-quill-wrap:not(.ha-quill--html) .ha-quill-html { display: none !important; }
  .ha-quill-html-toggle { padding: 2px 6px; font-size: 12px; cursor: pointer; border: 1px solid transparent; border-radius: 4px; background: transparent; }
  .ha-quill-html-toggle:hover { background: #f3f4f6; }
  .ha-quill-wrap.ha-quill--html .ha-quill-html-toggle { background: #1f2937; color: #fff; border-color: #1f2937; }
</style>
