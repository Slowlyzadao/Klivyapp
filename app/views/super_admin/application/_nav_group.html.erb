<%#
  Renders a collapsible nav group using <details>/<summary>.
  Locals: icon (string), label (string), items (Array of {icon:, url:, label:})
%>
<%
  group_active = items.any? { |i| current_page?(i[:url]) }
%>
<li class="px-4 mb-1">
  <details <%= 'open' if group_active %> class="ha-nav-group">
    <summary class="flex items-center px-2 py-1.5 rounded-lg cursor-pointer list-none select-none
                    text-slate-800 hover:text-woot-500 hover:bg-slate-25 transition-colors">
      <svg width="16" height="16" class="flex-shrink-0"><use xlink:href="#<%= icon %>" /></svg>
      <span class="ml-2 text-sm flex-1"><%= label %></span>
      <svg width="12" height="12" class="ha-nav-chevron flex-shrink-0 transition-transform">
        <use xlink:href="#icon-arrow-down-s-line" />
      </svg>
    </summary>
    <ul class="mt-1 ml-3 border-l border-slate-100 pl-2">
      <% items.each do |item| %>
        <%
          item_active = current_page?(item[:url])
          item_class  = item_active ? 'text-woot-500 bg-slate-25' : 'text-slate-700'
        %>
        <li class="mb-0.5">
          <%= link_to item[:url],
              class: item_class + " flex items-center gap-2 px-2 py-1.5 text-sm rounded-lg
                                   hover:text-woot-500 hover:bg-slate-25 transition-colors" do %>
            <svg width="14" height="14" class="flex-shrink-0"><use xlink:href="#<%= item[:icon] %>" /></svg>
            <span><%= item[:label] %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </details>
</li>

<style>
  .ha-nav-group[open] .ha-nav-chevron { transform: rotate(180deg); }
</style>
