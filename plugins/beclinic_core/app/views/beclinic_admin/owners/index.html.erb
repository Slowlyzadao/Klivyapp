<% content_for(:title) do %>
  Proprietários por Conta
<% end %>
<header class="main-content__header">
  <h1 class="main-content__page-title">
    <%= content_for(:title) %>
  </h1>
  <p style="color: #6b7280; margin: 0;">
    Gerencie qual usuário é o Proprietário de cada conta. O Proprietário tem acesso completo dentro da própria conta, exceto funções reservadas ao Super Admin (dono do SaaS).
  </p>
</header>
<section class="main-content__body">
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Conta</th>
        <th>Proprietário(s) atual(is)</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @accounts.each do |account| %>
        <tr>
          <td><%= account.id %></td>
          <td><%= account.name %></td>
          <td>
            <% owners = @owners_by_account[account.id] || [] %>
            <% if owners.empty? %>
              <em style="color: #dc2626;">Sem Proprietário definido</em>
            <% else %>
              <%= owners.map(&:email).join(', ') %>
            <% end %>
          </td>
          <td>
            <%= link_to 'Gerenciar', beclinic_admin_owner_path(account), class: 'button button--secondary' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <% if @accounts.respond_to?(:total_pages) && @accounts.total_pages > 1 %>
    <div style="margin-top: 16px;">
      <%= paginate @accounts %>
    </div>
  <% end %>
</section>
