<% content_for(:title) do %>
  Proprietário — <%= @account.name %>
<% end %>
<header class="main-content__header">
  <h1 class="main-content__page-title">
    <%= content_for(:title) %>
  </h1>
  <p style="margin: 0;">
    <%= link_to '← Voltar para todas as contas', beclinic_admin_owners_path %>
  </p>
</header>

<section class="main-content__body">
  <% if flash[:notice].present? %>
    <div style="padding: 12px 16px; background: #ecfdf5; border: 1px solid #a7f3d0; color: #065f46; margin-bottom: 16px; border-radius: 6px;">
      <%= flash[:notice] %>
    </div>
  <% end %>
  <% if flash[:error].present? %>
    <div style="padding: 12px 16px; background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; margin-bottom: 16px; border-radius: 6px;">
      <%= flash[:error] %>
    </div>
  <% end %>

  <h2 style="margin-top: 0;">Conta #<%= @account.id %> — <%= @account.name %></h2>

  <p style="color: #6b7280;">
    Selecione o usuário que deve ser promovido a Proprietário. Ao promover, o usuário ganha acesso completo dentro desta conta (exceto ações de Super Admin).
  </p>

  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Nome</th>
        <th>Email</th>
        <th>Cargo (AccountUser)</th>
        <th>Proprietário?</th>
        <th>Ação</th>
      </tr>
    </thead>
    <tbody>
      <% @account_users.each do |au| %>
        <% user = au.user %>
        <% is_owner = @current_owner_ids.include?(user.id) %>
        <tr>
          <td><%= user.id %></td>
          <td><%= user.name %></td>
          <td><%= user.email %></td>
          <td><%= au.role %></td>
          <td>
            <% if is_owner %>
              <span style="color: #059669; font-weight: 600;">✓ Sim</span>
            <% else %>
              —
            <% end %>
          </td>
          <td>
            <% if is_owner %>
              <em style="color: #6b7280;">Já é Proprietário</em>
            <% else %>
              <%= button_to 'Promover a Proprietário',
                            promote_beclinic_admin_owner_path(@account),
                            method: :post,
                            params: { user_id: user.id },
                            class: 'button button--primary',
                            data: { turbo_confirm: "Promover #{user.email} a Proprietário da conta #{@account.name}?" } %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>
