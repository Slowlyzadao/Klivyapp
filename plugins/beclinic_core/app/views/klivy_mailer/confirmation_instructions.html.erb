<% if @inviter.present? && @resource.unconfirmed_email.blank? %>
  <%= render 'invitation' %>
<% else %>
  <% if @resource.unconfirmed_email.present? %>
    <% heading = t('klivy_mailer.email_change.heading') %>
    <% body    = t('klivy_mailer.email_change.body') %>
    <% cta     = t('klivy_mailer.email_change.cta') %>
  <% else %>
    <% heading = t('klivy_mailer.confirmation.heading') %>
    <% body    = t('klivy_mailer.confirmation.body') %>
    <% cta     = t('klivy_mailer.confirmation.cta') %>
  <% end %>
  <% confirmation_url = frontend_url('auth/confirmation', confirmation_token: @token) %>

  <p style="margin: 0 0 16px 0; font-size: 16px; color: #111827;">
    <%= t('klivy_mailer.common.greeting_html', name: (@resource.try(:name).presence || @resource.email)).html_safe %>
  </p>

  <h1 style="margin: 0 0 16px 0; font-size: 24px; line-height: 1.3; font-weight: 700; color: #0f172a; letter-spacing: -0.01em;">
    <%= heading %>
  </h1>

  <p style="margin: 0 0 28px 0; font-size: 16px; line-height: 1.6; color: #374151;">
    <%= body %>
  </p>

  <table role="presentation" border="0" cellpadding="0" cellspacing="0" style="margin: 0 0 32px 0;">
    <tr>
      <td bgcolor="#2563eb" style="border-radius: 8px;">
        <a href="<%= confirmation_url %>"
           style="display: inline-block; padding: 14px 28px; font-size: 16px; font-weight: 600; color: #ffffff; text-decoration: none; border-radius: 8px; background-color: #2563eb; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
          <%= cta %>
        </a>
      </td>
    </tr>
  </table>

  <p style="margin: 0 0 8px 0; font-size: 13px; line-height: 1.5; color: #6b7280;">
    <%= t('klivy_mailer.common.fallback_link_label') %>
  </p>
  <p style="margin: 0 0 28px 0; font-size: 13px; line-height: 1.5; word-break: break-all;">
    <a href="<%= confirmation_url %>" style="color: #2563eb; text-decoration: underline;"><%= confirmation_url %></a>
  </p>

  <div style="margin-top: 8px; padding-top: 20px; border-top: 1px solid #e5e7eb;">
    <p style="margin: 0; font-size: 13px; line-height: 1.5; color: #6b7280;">
      <%= t('klivy_mailer.common.security_note') %>
    </p>
  </div>
<% end %>
