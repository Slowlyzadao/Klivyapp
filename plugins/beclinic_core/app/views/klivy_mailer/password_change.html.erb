<% support_email = ENV.fetch('MAILER_SUPPORT_EMAIL', 'suporte@klivy.app') %>

<p style="margin: 0 0 16px 0; font-size: 16px; color: #111827;">
  <%= t('klivy_mailer.common.greeting_html', name: (@resource.try(:name).presence || @resource.email)).html_safe %>
</p>

<h1 style="margin: 0 0 16px 0; font-size: 24px; line-height: 1.3; font-weight: 700; color: #0f172a; letter-spacing: -0.01em;">
  <%= t('klivy_mailer.password_change.heading') %>
</h1>

<p style="margin: 0 0 28px 0; font-size: 16px; line-height: 1.6; color: #374151;">
  <%= t('klivy_mailer.password_change.body') %>
</p>

<div style="margin: 0 0 28px 0; padding: 16px 20px; background-color: #fff7ed; border: 1px solid #fed7aa; border-radius: 8px;">
  <p style="margin: 0; font-size: 14px; line-height: 1.5; color: #9a3412;">
    <strong><%= t('klivy_mailer.password_change.alert') %></strong>
  </p>
</div>

<table role="presentation" border="0" cellpadding="0" cellspacing="0" style="margin: 0 0 8px 0;">
  <tr>
    <td bgcolor="#0f172a" style="border-radius: 8px;">
      <a href="mailto:<%= support_email %>"
         style="display: inline-block; padding: 12px 24px; font-size: 15px; font-weight: 600; color: #ffffff; text-decoration: none; border-radius: 8px; background-color: #0f172a; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
        <%= t('klivy_mailer.password_change.cta') %>
      </a>
    </td>
  </tr>
</table>
