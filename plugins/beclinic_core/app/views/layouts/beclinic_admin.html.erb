<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BeClinic Admin — <%= content_for?(:title) ? yield(:title) : 'Painel' %></title>
  <%= csrf_meta_tags %>
  <style>
    * { box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      max-width: 1200px;
      margin: 0 auto;
      padding: 24px;
      color: #1f2937;
      background: #f9fafb;
    }
    .main-content__header {
      border-bottom: 1px solid #e5e7eb;
      padding-bottom: 16px;
      margin-bottom: 24px;
    }
    .main-content__page-title {
      font-size: 24px;
      font-weight: 600;
      margin: 0 0 8px 0;
    }
    .main-content__body {
      background: white;
      border-radius: 8px;
      padding: 24px;
      box-shadow: 0 1px 2px rgba(0,0,0,0.04);
    }
    table { width: 100%; border-collapse: collapse; }
    th, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid #f1f5f9; vertical-align: middle; }
    th { background: #f8fafc; font-weight: 600; font-size: 13px; text-transform: uppercase; color: #64748b; }
    tr:last-child td { border-bottom: none; }
    .button {
      display: inline-block;
      padding: 6px 14px;
      border-radius: 6px;
      border: 1px solid;
      text-decoration: none;
      cursor: pointer;
      font-size: 14px;
      font-family: inherit;
    }
    .button--primary {
      background: #2563eb;
      color: white;
      border-color: #2563eb;
    }
    .button--primary:hover { background: #1d4ed8; }
    .button--secondary {
      background: white;
      color: #1f2937;
      border-color: #d1d5db;
    }
    .button--secondary:hover { background: #f3f4f6; }
    a { color: #2563eb; text-decoration: none; }
    a:hover { text-decoration: underline; }
    form { display: inline; margin: 0; }
  </style>
</head>
<body>
  <%= yield %>
</body>
</html>
