<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" lang="pt-BR">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="x-apple-disable-message-reformatting" />
  <meta name="color-scheme" content="light" />
  <meta name="supported-color-schemes" content="light" />
  <title>Klivy</title>
  <!--[if mso]>
  <style type="text/css">
    table, td, div, h1, p { font-family: Arial, Helvetica, sans-serif; }
  </style>
  <![endif]-->
  <style type="text/css">
    @media only screen and (max-width: 620px) {
      .klivy-wrapper { width: 100% !important; }
      .klivy-card { border-radius: 0 !important; }
      .klivy-content { padding: 28px 20px !important; }
      .klivy-header { padding: 24px 20px !important; }
    }
  </style>
</head>
<body style="margin: 0; padding: 0; background-color: #f4f6f8; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
  <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #f4f6f8;">
    <tr>
      <td align="center" style="padding: 32px 16px;">
        <table role="presentation" class="klivy-wrapper" border="0" cellpadding="0" cellspacing="0" width="600" style="max-width: 600px; width: 100%;">
          <tr>
            <td>
              <table role="presentation" class="klivy-card" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 1px 3px rgba(17, 24, 39, 0.06), 0 4px 16px rgba(17, 24, 39, 0.06);">
                <tr>
                  <td class="klivy-header" align="center" style="background-color: #ffffff; padding: 32px 32px 24px 32px; border-bottom: 1px solid #eef0f3;">
                    <a href="<%= root_url %>" style="text-decoration: none; border: 0;">
                      <img src="<%= root_url %>brand-assets/logo.png" alt="Klivy" height="36" style="display: block; height: 36px; width: auto; border: 0; outline: none; -ms-interpolation-mode: bicubic;" />
                    </a>
                  </td>
                </tr>
                <tr>
                  <td class="klivy-content" style="padding: 40px 40px 32px 40px; color: #111827; font-size: 16px; line-height: 1.6; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
                    <%= yield %>
                  </td>
                </tr>
              </table>
              <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
                <tr>
                  <td align="center" style="padding: 24px 16px 8px 16px; color: #9ca3af; font-size: 12px; line-height: 1.5; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
                    <%= t('klivy_mailer.common.footer_automated') %>
                  </td>
                </tr>
                <tr>
                  <td align="center" style="padding: 4px 16px 32px 16px; color: #9ca3af; font-size: 12px; line-height: 1.5; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
                    <%= t('klivy_mailer.common.footer_rights', year: Time.current.year) %>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
